<%- include("../partials/head", {}) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">الحضور — جلسة <%= new Date(sheet.session.date).toISOString().slice(0, 10) %></h1>
  <a class="btn btn-outline-secondary btn-sm" href="/courses/<%= sheet.session.courseId %>/sessions">رجوع إلى الجلسات</a>
</div>

<p class="text-muted">الدورة: <b><%= sheet.session.course.title %></b> — الوضع: <b><%= sheet.editable ? "تعديل" : "عرض فقط (للمدير)" %></b></p>

<% if (sheet.rows.length === 0) { %>
  <div class="alert alert-info">لا يوجد متدربون في حالة (مؤكدة) على هذه الدورة بعد.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <form method="post" action="/sessions/<%= sheet.session.id %>/attendance">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr><th>المتدرب</th><th>الحالة</th></tr>
          </thead>
          <tbody>
            <% sheet.rows.forEach(function (row) { %>
              <tr>
                <td><%= row.trainee.name %></td>
                <td>
                  <div class="d-flex gap-4">
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="status_<%= row.trainee.id %>" id="p_<%= row.trainee.id %>" value="PRESENT"
                             <%= row.attendance && row.attendance.status === "PRESENT" ? "checked" : "" %>
                             <%= sheet.editable ? "" : "disabled" %>>
                      <label class="form-check-label" for="p_<%= row.trainee.id %>">حاضر</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="status_<%= row.trainee.id %>" id="a_<%= row.trainee.id %>" value="ABSENT"
                             <%= row.attendance && row.attendance.status === "ABSENT" ? "checked" : "" %>
                             <%= sheet.editable ? "" : "disabled" %>>
                      <label class="form-check-label" for="a_<%= row.trainee.id %>">غائب</label>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (sheet.editable) { %>
          <button type="submit" class="btn btn-primary mt-3">حفظ الحضور</button>
        <% } %>
      </form>
    </div>
  </div>
<% } %>

<%- include("../partials/foot") %>
