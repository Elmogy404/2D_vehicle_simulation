<%- include("../partials/head", {}) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">عرض الحضور — <%= overview.course.title %></h1>
  <a class="btn btn-outline-secondary btn-sm" href="/courses">رجوع</a>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>#</th><th>التاريخ</th><th>العنوان</th><th>حضر</th><th>غاب</th><th></th></tr>
      </thead>
      <tbody>
        <% if (overview.sessions.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">لا توجد جلسات لهذه الدورة.</td></tr>
        <% } %>
        <% overview.sessions.forEach(function (s, idx) { %>
          <tr>
            <td><%= idx + 1 %></td>
            <td class="text-nowrap"><%= new Date(s.date).toISOString().slice(0, 10) %></td>
            <td><%= s.title || "—" %></td>
            <td><%= s.present %></td>
            <td><%= s.absent %></td>
            <td><a class="btn btn-sm btn-outline-secondary" href="/sessions/<%= s.id %>">عرض</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/foot") %>
