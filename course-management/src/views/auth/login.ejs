<%- include("../partials/head", {}) %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">تسجيل الدخول</h1>

        <% if (typeof formError !== "undefined" && formError) { %>
          <div class="alert alert-danger"><%= formError %></div>
        <% } %>

        <form method="post" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>">

          <div class="mb-3">
            <label class="form-label" for="login-email">البريد الإلكتروني</label>
            <input type="email" class="form-control <%= fieldErrors.email ? "is-invalid" : "" %>" id="login-email" name="email"
                   value="<%= typeof values !== "undefined" && values.email ? values.email : "" %>" autofocus required>
            <% if (fieldErrors.email) { %><div class="invalid-feedback"><%= fieldErrors.email[0] %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="login-password">كلمة المرور</label>
            <input type="password" class="form-control <%= fieldErrors.password ? "is-invalid" : "" %>" id="login-password" name="password" required>
            <% if (fieldErrors.password) { %><div class="invalid-feedback"><%= fieldErrors.password[0] %></div><% } %>
          </div>

          <button type="submit" class="btn btn-primary w-100">تسجيل الدخول</button>
        </form>

        <p class="mt-3 mb-0 text-center small">
          ليس لديك حساب متدرب؟ <a href="/register">أنشئ حساباً جديداً</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/foot") %>
