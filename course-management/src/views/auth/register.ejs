<%- include("../partials/head", {}) %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">إنشاء حساب متدرب جديد</h1>

        <% if (typeof formError !== "undefined" && formError) { %>
          <div class="alert alert-danger"><%= formError %></div>
        <% } %>

        <form method="post" action="/register" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>">

          <div class="mb-3">
            <label class="form-label" for="reg-name">الاسم الكامل</label>
            <input type="text" class="form-control <%= fieldErrors.name ? "is-invalid" : "" %>" id="reg-name" name="name"
                   value="<%= typeof values !== "undefined" && values.name ? values.name : "" %>" required autofocus>
            <% if (fieldErrors.name) { %><div class="invalid-feedback"><%= fieldErrors.name[0] %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="reg-email">البريد الإلكتروني</label>
            <input type="email" class="form-control <%= fieldErrors.email ? "is-invalid" : "" %>" id="reg-email" name="email"
                   value="<%= typeof values !== "undefined" && values.email ? values.email : "" %>" required>
            <% if (fieldErrors.email) { %><div class="invalid-feedback"><%= fieldErrors.email[0] %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="reg-password">كلمة المرور</label>
            <input type="password" class="form-control <%= fieldErrors.password ? "is-invalid" : "" %>" id="reg-password" name="password" required minlength="8">
            <div class="form-text">٨ أحرف على الأقل</div>
            <% if (fieldErrors.password) { %><div class="invalid-feedback"><%= fieldErrors.password[0] %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="reg-confirm">تأكيد كلمة المرور</label>
            <input type="password" class="form-control <%= fieldErrors.confirmPassword ? "is-invalid" : "" %>" id="reg-confirm" name="confirmPassword" required>
            <% if (fieldErrors.confirmPassword) { %><div class="invalid-feedback"><%= fieldErrors.confirmPassword[0] %></div><% } %>
          </div>

          <button type="submit" class="btn btn-primary w-100">إنشاء الحساب</button>
        </form>

        <p class="mt-3 mb-0 text-center small">
          الحساب الجديد يكون بمستوى «متدرب». يُنشئ مدير النظام حسابات المدربين.
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/foot") %>
