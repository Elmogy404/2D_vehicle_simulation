<%- include("../partials/head", {}) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h4 mb-0">تفاصيل الدورة</h1>
  <a class="btn btn-outline-secondary btn-sm" href="<%= currentUser.role === "TRAINER" ? "/courses" : "/courses" %>">رجوع</a>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5"><%= course.title %></h2>
    <p class="text-muted"><%= course.description %></p>
    <dl class="row mb-0">
      <dt class="col-sm-2">السعر</dt>
      <dd class="col-sm-10"><%= course.price.toFixed ? course.price.toFixed(2) : String(course.price) %> ر.س</dd>
      <dt class="col-sm-2">المدرب</dt>
      <dd class="col-sm-10"><%= course.trainer.name %></dd>
      <dt class="col-sm-2">الحجوزات</dt>
      <dd class="col-sm-10"><%= course._count.bookings %></dd>
      <dt class="col-sm-2">الجلسات</dt>
      <dd class="col-sm-10"><%= course._count.sessions %></dd>
    </dl>
  </div>
</div>

<div class="d-flex gap-2 flex-wrap">
  <% if (currentUser.role === "ADMIN") { %>
    <a class="btn btn-outline-primary" href="/courses/<%= course.id %>/edit">تعديل الدورة</a>
    <form class="d-inline" method="post" action="/courses/<%= course.id %>" onsubmit="return confirm('هل تريد حذف هذه الدورة؟')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="btn btn-outline-danger">حذف</button>
    </form>
  <% } else if (currentUser.role === "TRAINER") { %>
    <a class="btn btn-outline-primary" href="/courses/<%= course.id %>/sessions">جلسات الدورة</a>
  <% } else { %>
    <% if (myBooking) { %>
      <span class="alert alert-info py-2 mb-0">حالتك في هذه الدورة: <b><%= t.bookings.statusLabels[myBooking.status] %></b> — راجع <a href="/bookings/mine">حجوزاتي</a>.</span>
    <% } else { %>
      <form method="post" action="/bookings" onsubmit="return confirm('هل تريد تسجيل حجز لهذه الدورة؟')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="courseId" value="<%= course.id %>">
        <button type="submit" class="btn btn-primary">احجز هذه الدورة</button>
      </form>
    <% } %>
  <% } %>
</div>

<%- include("../partials/foot") %>
