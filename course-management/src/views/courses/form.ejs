<%- include("../partials/head", {}) %>

<h1 class="h4 mb-4"><%= isEdit ? "تعديل الدورة" : "دورة جديدة" %></h1>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <form method="post" action="<%= formAction %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label class="form-label" for="course-title">عنوان الدورة</label>
            <input type="text" class="form-control <%= fieldErrors.title ? "is-invalid" : "" %>" id="course-title" name="title"
                   value="<%= course.title || "" %>" required minlength="3" autocomplete="off">
            <% if (fieldErrors.title) { %><div class="invalid-feedback"><%= fieldErrors.title[0] %></div><% } %>
          </div>

          <div class="mb-3">
            <label class="form-label" for="course-description">الوصف</label>
            <textarea class="form-control <%= fieldErrors.description ? "is-invalid" : "" %>" id="course-description" name="description"
                      required minlength="10"><%= course.description || "" %></textarea>
            <% if (fieldErrors.description) { %><div class="invalid-feedback"><%= fieldErrors.description[0] %></div><% } %>
          </div>

          <div class="row">
            <div class="col-md-5 mb-3">
              <label class="form-label" for="course-price">السعر (ر.س)</label>
              <input type="number" step="0.01" min="0" class="form-control <%= fieldErrors.price ? "is-invalid" : "" %>" id="course-price" name="price"
                     value="<%= course.price != null && course.price !== "" ? course.price : "" %>" required>
              <% if (fieldErrors.price) { %><div class="invalid-feedback"><%= fieldErrors.price[0] %></div><% } %>
            </div>

            <div class="col-md-7 mb-3">
              <label class="form-label" for="course-trainer">المدرب</label>
              <select class="form-select <%= fieldErrors.trainerId ? "is-invalid" : "" %>" id="course-trainer" name="trainerId" required>
                <option value="">اختر المدرب…</option>
                <% trainers.forEach(function (tr) { %>
                  <option value="<%= tr.id %>" <%= String(course.trainerId) === String(tr.id) ? "selected" : "" %>><%= tr.name %></option>
                <% }) %>
              </select>
              <% if (fieldErrors.trainerId) { %><div class="invalid-feedback"><%= fieldErrors.trainerId[0] %></div><% } %>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a class="btn btn-outline-secondary" href="/courses">إلغاء</a>
          </div>
          <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/foot") %>
