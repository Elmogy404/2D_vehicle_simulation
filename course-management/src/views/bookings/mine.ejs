<%- include("../partials/head", {}) %>

<h1 class="h4 mb-4">حجوزاتي</h1>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>الدورة</th>
          <th>المدرب</th>
          <th>السعر (ر.س)</th>
          <th>الحالة</th>
          <th>تاريخ الحجز</th>
          <th class="text-nowrap">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% if (bookings.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">لا توجد حجوزات.</td></tr>
        <% } %>
        <% bookings.forEach(function (b, idx) { %>
          <tr>
            <td><%= (pageCtx.page - 1) * 8 + idx + 1 %></td>
            <td><a class="text-decoration-none" href="/courses/<%= b.course.id %>"><%= b.course.title %></a></td>
            <td><%= b.course.trainer.name %></td>
            <td><%= b.course.price.toFixed ? b.course.price.toFixed(2) : String(b.course.price) %></td>
            <td><span class="badge badge-status-<%= b.status %>"><%= t.bookings.statusLabels[b.status] %></span></td>
            <td class="text-nowrap"><%= new Date(b.createdAt).toISOString().slice(0, 10) %></td>
            <td class="text-nowrap">
              <% if (b.status === "PENDING") { %>
                <form class="d-inline" method="post" action="/bookings/<%= b.id %>/cancel" onsubmit="return confirm('هل تريد إلغاء هذا الحجز؟')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="_method" value="PUT">
                  <button type="submit" class="btn btn-sm btn-outline-danger">إلغاء الحجز</button>
                </form>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/pagination", {}) %>

<%- include("../partials/foot") %>
