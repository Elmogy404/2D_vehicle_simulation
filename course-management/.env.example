# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Random strings (openssl rand -hex 32)
SESSION_SECRET=replace-with-random-64-hex-chars
CSRF_SECRET=replace-with-random-64-hex-chars

# PostgreSQL. Locally (docker compose up) use:
# postgresql://postgres:postgres@localhost:5432/courses_dev
DATABASE_URL=postgresql://user:password@host:5432/db
# Direct (non-pooled) connection used by Prisma for migrations
DIRECT_URL=postgresql://user:password@host:5432/db

# Separate database used by the test suite (`npm test`). Locally: postgresql://postgres:postgres@localhost:5432/courses_test
TEST_DATABASE_URL=postgresql://user:password@host:5432/db_test
TEST_DIRECT_URL=postgresql://user:password@host:5432/db_test
